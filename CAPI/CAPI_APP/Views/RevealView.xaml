<UserControl x:Class="CAPI_APP.Views.RevealView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CAPI_APP.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:RevealViewModel}">
    <StackPanel Margin="24">
        <TextBlock Text="Révélation des votes" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Voici la carte jouée par chaque joueur." Margin="0,4,0,20" Foreground="Gray" />

        <ItemsControl ItemsSource="{Binding Votes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6" Width="104">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="104">
                            <TextBlock Text="{Binding Value.Label}" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Key.Name}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
